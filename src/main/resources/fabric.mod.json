{
    "schemaVersion": 1,
    "id": "random-teleporter",
    "version": "${version}",
    "name": "RandomTeleporter",
    "description": "Adds the /rtp command, which teleports players to random positions in the world.",
    "authors": ["MadKarma"],
    "contributors": ["TheWhiteDog9487"],
    "contact": {
        "sources": "https://github.com/madkarmaa/RandomTeleporter",
        "issues": "https://github.com/madkarmaa/RandomTeleporter/issues"
    },
    "license": "MIT",
    "icon": "assets/random-teleporter/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "top.madkarma.randomteleporter.RandomTeleporter",
                "adapter": "kotlin"
            }
        ]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    }
}
